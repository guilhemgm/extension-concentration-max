{
  "manifest_version": 3,
  "name": "MEGA CONCENTRATION",
  "version": "6.7",
  "description": "Bloque les sites distrayants et concentre-toi sur ce qui compte vraiment.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "tabs", 
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MEGA CONCENTRATION"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["timer.html"],
      "matches": ["<all_urls>"]
    }
  ]
}